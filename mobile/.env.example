# Copy to mobile/.env and set the address of YOUR backend as the PHONE sees it.
#
# The phone cannot reach "localhost" on your computer. Use your computer's
# local network IP address (same Wi-Fi as the phone):
#   Windows: run `ipconfig`  -> "IPv4 Address", e.g. 192.168.1.23
#   macOS:   run `ipconfig getifaddr en0`
#   Linux:   run `hostname -I`
# Android emulator only: http://10.0.2.2:8000 reaches your computer.
#
# Development uses plain HTTP on your own network. Production must use HTTPS.
EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
