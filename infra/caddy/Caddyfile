# TraceHealth production web server (Caddy 2).
# Caddy gets and renews HTTPS certificates from Let's Encrypt automatically,
# as long as both domains point at this server and ports 80/443 are open.
{
	email {$ACME_EMAIL}
}

# --- API (mobile app, dashboard, M-Pesa callbacks) --------------------------
{$API_DOMAIN} {
	encode zstd gzip
	# Report photos are up to MAX_PHOTO_MB; clinic CSVs up to 5 MB
	request_body {
		max_size 10MB
	}
	reverse_proxy api:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# --- Web dashboard (static files built by infra/caddy/Dockerfile) ------------
{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	root * /srv/dashboard
	# Hashed assets never change: cache for a year. index.html: always revalidate.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	# Single-page app: unknown paths load index.html, React Router takes over
	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data: https://tile.openstreetmap.org; connect-src 'self' https://{$API_DOMAIN}; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
