# ---------------------------------------------------------------------------
# TraceHealth environment variables
# Copy this file to ".env" in the same folder and change the values.
# ".env" is listed in .gitignore: it must NEVER be committed to Git.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- PostgreSQL container (docker-compose.yml reads these) -----------------
POSTGRES_USER=tracehealth
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=tracehealth
# 5433 avoids clashing with any PostgreSQL already installed on your computer
POSTGRES_PORT=5433

# --- Backend database connections ------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://tracehealth:change_me_local_only@localhost:5433/tracehealth
# Separate database that the automated tests wipe and rebuild on every run
TEST_DATABASE_URL=postgresql+psycopg://tracehealth:change_me_local_only@localhost:5433/tracehealth_test

# --- Web dashboard origin(s) allowed to call the API (comma-separated) -----
CORS_ORIGINS=http://localhost:5173

# --- Development seed data only --------------------------------------------
SEED_DEFAULT_PASSWORD=ChangeMe123!

# Variables for JWT, photo storage, push/SMS and M-Pesa are added in the
# sprint that introduces each feature, with instructions for obtaining them.
