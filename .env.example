# ---------------------------------------------------------------------------
# TraceHealth environment variables
# Copy this file to ".env" in the same folder and change the values.
# ".env" is listed in .gitignore: it must NEVER be committed to Git.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- PostgreSQL container (docker-compose.yml reads these) -----------------
POSTGRES_USER=tracehealth
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=tracehealth
# 5433 avoids clashing with any PostgreSQL already installed on your computer
POSTGRES_PORT=5433

# --- Backend database connections ------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://tracehealth:change_me_local_only@localhost:5433/tracehealth
# Separate database that the automated tests wipe and rebuild on every run
TEST_DATABASE_URL=postgresql+psycopg://tracehealth:change_me_local_only@localhost:5433/tracehealth_test

# --- Web dashboard origin(s) allowed to call the API (comma-separated) -----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Development seed data only --------------------------------------------
SEED_DEFAULT_PASSWORD=ChangeMe123!

# --- Authentication (Sprint 1) --------------------------------------------
# Secret used to sign login tokens. Generate your own long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone who knows it can forge logins, so never commit or share it.
JWT_SECRET_KEY=replace-me-with-the-output-of-the-command-above
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Phone numbers typed as 07... are stored with this country code (Kenya = 254)
DEFAULT_COUNTRY_CODE=254

# --- Report photos (Sprint 1) ---------------------------------------------
# Leave UPLOAD_DIR unset to use backend/uploads (ignored by Git)
# UPLOAD_DIR=/absolute/path/to/uploads
MAX_PHOTO_MB=8
PHOTO_MAX_DIMENSION=1600
REPORT_MAX_AGE_DAYS=30

# --- Notifications (Sprint 2) --------------------------------------------
# mock = nothing leaves the server; deliveries are logged and marked MOCK-...
# Push: mock | expo | disabled
PUSH_PROVIDER=mock
# Only if you switch on "enhanced push security" in your Expo project settings
# EXPO_ACCESS_TOKEN=

# SMS fallback: mock | africastalking | disabled
SMS_PROVIDER=mock
# Africa's Talking sandbox: sign up at africastalking.com, open the Sandbox
# app, go to Settings > API Key and generate a key. The sandbox username is
# always "sandbox". Sandbox messages appear in the AT simulator, not on phones.
AT_USERNAME=sandbox
# AT_API_KEY=paste-your-sandbox-api-key
# AT_SENDER_ID=          (leave empty in the sandbox)

# --- Incentive payouts (Sprint 4) -------------------------------------------
# MOCK = no real money moves; every payout is marked MOCK-... and shown as "Test".
# Phone numbers ending in 0000 simulate a failed payment, to try the retry flow.
PAYOUT_PROVIDER=MOCK
PAYOUT_MAX_ATTEMPTS=5
PAYOUT_RESULT_TIMEOUT_HOURS=24

# M-Pesa Daraja B2C SANDBOX (no real money). Step-by-step: docs/deployment.md
#   1. Register at developer.safaricom.co.ke, create an app with "M-Pesa Sandbox"
#      -> Consumer Key and Consumer Secret
#   2. Test credentials page -> B2C shortcode, initiator name, and generate the
#      Security Credential (encrypted initiator password)
#   3. Safaricom must reach MPESA_CALLBACK_BASE_URL over HTTPS: on your laptop
#      use a tunnel, e.g.  cloudflared tunnel --url http://localhost:8000
# Then set PAYOUT_PROVIDER=MPESA_DARAJA.
MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_CALLBACK_BASE_URL=https://your-tunnel.example
# MPESA_CALLBACK_TOKEN=another-long-random-value

# --- Background jobs (Sprint 4) ---------------------------------------------
# Sends due payouts, expires M-Pesa requests with no result, retries
# undelivered push/SMS. In production they run in a separate process instead.
BACKGROUND_JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60

# --- Photo storage (D6) -----------------------------------------------------
# local = backend/uploads (or UPLOAD_DIR); s3 = any S3-compatible bucket
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=        (Cloudflare R2 / MinIO; leave empty for AWS)
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Database connections per API worker -------------------------------------
# workers x (pool + overflow) must stay below PostgreSQL's max_connections (100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
