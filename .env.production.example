# ---------------------------------------------------------------------------
# TraceHealth PRODUCTION settings (docker-compose.prod.yml).
# Copy to ".env.production" on the server ONLY. Never commit the copy.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Domains (both must point at this server's public IP) -----------------
API_DOMAIN=api.example.org
DASHBOARD_DOMAIN=dashboard.example.org
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=ops@example.org

# --- Database --------------------------------------------------------------
POSTGRES_USER=tracehealth
POSTGRES_PASSWORD=generate-a-long-random-value
POSTGRES_DB=tracehealth

# --- Security --------------------------------------------------------------
JWT_SECRET_KEY=generate-a-different-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DEFAULT_COUNTRY_CODE=254

# --- Photos ------------------------------------------------------------------
# local = Docker volume "uploads" (back it up!), or s3 for object storage
STORAGE_BACKEND=local
# S3_BUCKET=tracehealth-photos
# S3_ENDPOINT_URL=        (Cloudflare R2 / MinIO; leave empty for AWS)
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Notifications -----------------------------------------------------------
# Keep "mock" until the providers are approved for the pilot
PUSH_PROVIDER=mock
SMS_PROVIDER=mock
AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# --- Payouts -------------------------------------------------------------------
# MOCK moves no money. Switch to MPESA_DARAJA only after the sandbox checks in
# docs/deployment.md and written approval from the pilot partner.
PAYOUT_PROVIDER=MOCK
MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_CALLBACK_BASE_URL=https://api.example.org
# MPESA_CALLBACK_TOKEN=generate-another-long-random-value
